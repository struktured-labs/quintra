// SteamPipe app build for Quintra. Generated by desktop/scripts/package.sh
// into builds/steam/scripts/. Placeholder IDs are 0 until Steamworks issues
// them. "SetLive" stays empty: promote builds by hand in Steamworks.
"AppBuild"
{
	"AppID" "__STEAM_APP_ID__"
	"Desc" "__BUILD_DESC__"
	"ContentRoot" "../content/"
	"BuildOutput" "../output/"
	"SetLive" ""
	"Preview" "0"
	"Depots"
	{
		"__STEAM_DEPOT_WINDOWS__" "depot_build_windows.vdf"
		"__STEAM_DEPOT_LINUX__" "depot_build_linux.vdf"
	}
}
