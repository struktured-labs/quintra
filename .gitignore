# ROM files (cannot redistribute). The working cartridge is a local/CI
# build product. `make` and the ROM CI job write rom/working/quintra.gbc;
# CI uploads that file as the quintra-gbc artifact. Do not `git add -f` it,
# and do not attach it to a public GitHub Release.
*.gb
*.gbc
*.gba
rom/**/*.gb
rom/**/*.gbc
rom/working/quintra.gbc
rom/**/*.ram
rom/**/*.sav

# Build artifacts (C)
obj/
builds/
*.ihx
*.map
*.noi
*.sym
*.lk
*.lst
*.rel
*.asm

# Build artifacts (Rust)
tools/target/
target/
Cargo.lock.bak

# Generated code (regenerable from content/)
src/generated/

# Python (legacy)
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Temp / log
tmp/
test_output/
logs/
debug_*.png
*.log
tests/results/
DONE

# Save states (case-by-case)
*.ss0
*.ss1
*.ss2
*.ss3

# Environment / secrets
setenv.sh
.env
.env.local

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude harness local state
.claude/scheduled_tasks.lock
